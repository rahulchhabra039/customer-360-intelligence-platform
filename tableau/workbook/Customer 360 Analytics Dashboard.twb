      <column caption='Identified Order Rate' datatype='real' name='[Calculation_1416945075349868545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([customer_id]) THEN [order_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id])' />
