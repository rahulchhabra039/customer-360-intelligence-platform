      <column caption='Conversion Rate:' datatype='real' name='[Calculation_791507677818175488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_sessions]) = 0 THEN 0&#13;&#10;ELSE SUM([ga4_purchase_events]) / SUM([total_sessions])&#13;&#10;END' />
